{
  "name": "aem-mcp-server",
  "version": "1.0.1",
  "description": "AEM Model Context Protocol (MCP) server",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easingthemes/aem-mcp-server"
  },
  "keywords": [
    "AEM",
    "MCP",
    "Model Context Protocol",
    "LLM",
    "Adobe Experience Manager",
    "TypeScript"
  ],
  "main": "./dist/index.js",
  "bin": {
    "aem-mcp": "./cli/cli.js"
  },
  "files": [
    "cli/**/*.js",
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/**/*.ts --outdir=dist --platform=node --format=cjs",
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.20.3",
    "yargs": "^18.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.25.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
